rules_version = '2';

// Mono Music: every signed-in user can read and write ONLY their own data
// (library, playlists, devices). Nobody else — not even other signed-in
// users — can see it. Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
